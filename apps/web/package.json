{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh -c '[ -n \"$DATABASE_URL\" ] && pnpm db:migrate; next start'",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --conditions=react-server --import tsx lib/comments.check.ts",
    "db:check:profiles": "node --conditions=react-server --import tsx lib/profiles.check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@noble/hashes": "^1.8.0",
    "@privy-io/react-auth": "^3.35.1",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.14",
    "@tanstack/react-query": "^5.101.2",
    "@workspace/contracts": "workspace:*",
    "@workspace/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pinata": "^2.5.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "viem": "^2.55.2",
    "wagmi": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "server-only": "^0.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
