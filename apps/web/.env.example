# --- Chain: Arc Testnet (5042002) ---
# Optional. Falls back to https://rpc.testnet.arc.network.
NEXT_PUBLIC_ARC_RPC=

# --- Our launchpad, once deployed to Arc ---
# Deploy with launchpad-contracts/script/Deploy.s.sol, then paste the three
# addresses it prints. Until these are set the app renders an empty launchpad
# rather than crashing (see CONTRACTS_CONFIGURED in lib/chain.ts).
NEXT_PUBLIC_LAUNCH_FACTORY=
NEXT_PUBLIC_LP_LOCKER=
NEXT_PUBLIC_FEE_LOCKER=

# --- Wallet ---
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Indexer ---
# Server-side reads (server components).
INDEXER_URL=
# Client-side reads (portfolio). MUST be NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_INDEXER_URL=

# --- Coin image upload (Pinata / IPFS) ---
# Server-only. A SCOPED Pinata key (upload-only), never NEXT_PUBLIC_ — the JWT is
# a bearer credential; anyone who gets it can pin to the account.
PINATA_JWT=
# Server-only. Privy app secret — verifies the caller's auth token on /api/pin.
PRIVY_APP_SECRET=
# Public. The gateway host that renders uploaded art. Use a DEDICATED Pinata
# gateway in prod; falls back to the public gateway if unset.
NEXT_PUBLIC_IPFS_GATEWAY=
# Public. Site origin for OG/canonical URLs. Set in prod; dev falls back to localhost.
NEXT_PUBLIC_SITE_URL=
