# =============================================================================
#  berth.club web — environment
# =============================================================================
#  Two kinds of vars, read through two modules (never process.env elsewhere):
#
#    lib/env.ts         PUBLIC (NEXT_PUBLIC_*) — inlined into the client bundle
#                       at BUILD time. In Docker they are build ARGs; on Railway
#                       and locally they are ordinary vars.
#    lib/server-env.ts  SERVER-only (secrets, internal URLs) — `server-only`, so
#                       they can never reach the browser. Read at runtime.
#
#  Contract addresses are NOT here — they live in @workspace/contracts, the one
#  source of truth shared with the indexer.
#  For the full local stack (web + indexer + Postgres) use ../../docker-compose.yml.
# =============================================================================

# --- PUBLIC (client, NEXT_PUBLIC_*) ------------------------------------------
# Privy app id — wallet connect + auth. Empty = wallet UI disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Indexer base URL the BROWSER hits (must be publicly reachable).
NEXT_PUBLIC_INDEXER_URL=
# Arc RPC for client wallet/tx. Falls back to https://rpc.testnet.arc.network.
NEXT_PUBLIC_RPC_URL=
# IPFS gateway that renders coin art. Falls back to the public Pinata gateway.
NEXT_PUBLIC_IPFS_GATEWAY=
# Canonical site origin for OpenGraph/canonical URLs. Falls back to localhost.
NEXT_PUBLIC_SITE_URL=

# --- SERVER (runtime, secrets) -----------------------------------------------
# Indexer base URL for SERVER-side reads. In prod the Railway-internal URL;
# distinct from NEXT_PUBLIC_INDEXER_URL, which the browser must reach.
INDEXER_URL=
# Comments Postgres. Unset => comments degrade to read-empty / 503.
DATABASE_URL=
# Privy app secret — verifies auth tokens on /api routes.
PRIVY_APP_SECRET=
# Scoped (upload-only) Pinata JWT — pins coin art to IPFS.
PINATA_JWT=

# --- Profile editing ---
# "1" turns profile editing on (onboarding prompt, edit form, avatar
# upload). Unset = off, which is the default in prod. Reading is never
# gated: existing names and avatars still render. NEXT_PUBLIC = build-time.
NEXT_PUBLIC_PROFILE_EDITING=

# --- Cloudflare R2 (profile avatars; coin images stay on Pinata) ---
# Public base URL that serves avatars — MUST be a cookie-less host (the r2.dev
# URL or a dedicated subdomain, never the app origin). NEXT_PUBLIC = build-time.
NEXT_PUBLIC_R2_PUBLIC_BASE=
# R2 account id (endpoint is https://<id>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
# R2 API token (S3-compatible) with object read/write on the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name.
R2_BUCKET=
