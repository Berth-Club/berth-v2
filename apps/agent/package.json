{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:clock": "node --env-file-if-exists=../../.env --import tsx src/clock.selfcheck.ts",
    "check:loop": "node --env-file-if-exists=../../.env --import tsx src/jobs/loop.check.ts",
    "check:migrations": "node --env-file-if-exists=../../.env --import tsx src/migrations.check.ts",
    "check:hygiene": "node --env-file-if-exists=../../.env --import tsx src/connectors/hygiene.selfcheck.ts",
    "check:github": "node --env-file-if-exists=../../.env --import tsx src/connectors/github.check.ts",
    "check:lane": "GITHUB_TOKEN=test-token node --env-file-if-exists=../../.env --import tsx src/jobs/laneRead.check.ts",
    "check:scoring": "node --env-file-if-exists=../../.env --import tsx src/scoring/scoring.selfcheck.ts",
    "check:split": "node --env-file-if-exists=../../.env --import tsx src/epoch/split.selfcheck.ts",
    "check:pipeline": "GITHUB_TOKEN=test-token node --env-file-if-exists=../../.env --import tsx src/jobs/pipeline.check.ts",
    "demo:week": "node --env-file-if-exists=../../.env --import tsx src/demo/week.ts"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1",
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.12"
  }
}
