# The Harbormaster worker and the database package.
#
#   cp .env.example .env
#
# One file, at the repo root, read by every script in the workspace. `.env` is
# gitignored; this file is not, so never put a real secret in here.
#
# Anything already set in your shell WINS over this file, so a one-off override
# still works and is worth preferring for anything you would not want to forget
# you had set:
#
#   HM_LANE_CAP=5 pnpm --filter agent demo:week vercel/next.js
#
# The web app is separate: Next.js reads apps/web/.env.local on its own.
#
# A missing secret degrades only the handler that needs it. The worker still
# boots, logs what it cannot do, and the jobs that need the missing thing wait
# instead of failing. So an empty file is a valid file.


# ── the database ──────────────────────────────────────────────────────────────
# The only variable the worker genuinely cannot start without.
# Local dev, from the compose file:
DATABASE_URL=postgres://berth:berth@127.0.0.1:5432/harbormaster_dev


# ── reading work ──────────────────────────────────────────────────────────────
# Fine-grained, READ-ONLY. Reading public repositories needs no write scope, and
# this token only ever lists closed pull requests.
#   gh auth token
GITHUB_TOKEN=

# FOMO callouts, read from the callout bot's archive rather than from FOMO.
#
# FOMO has no public API: its backend sits behind Cloudflare and a short-lived
# token, so the payout path reads the Postgres the callout bot already fills.
# This is that database, and it is NOT the Harbormaster's own.
#
# It is the DATABASE_URL on the Postgres service of the `pumpcallouts` Railway
# project. The internal `postgres.railway.internal` host only resolves inside
# Railway, so running locally needs the TCP proxy turned on for that service
# and the public URL Railway then generates.
FOMO_ARCHIVE_DATABASE_URL=


# ── scoring ───────────────────────────────────────────────────────────────────
# Set ONE of these. With several set and no HM_SCORER, the order is OpenRouter,
# Anthropic, DeepSeek: one key and one bill is the reason to have OpenRouter.
#
# OpenRouter fronts the others behind a single key.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Pin the provider. `openrouter` | `anthropic` | `deepseek`.
# Naming one whose key is missing scores nothing rather than quietly falling
# through to another, because a week scored by a model you did not choose is
# worse than a week that waits.
HM_SCORER=

# Override the provider's default model. Through OpenRouter the id must carry
# its vendor prefix, and that id lands on every audit row.
#   deepseek/deepseek-chat  ·  anthropic/claude-sonnet-4.5  ·  deepseek-reasoner
HM_SCORER_MODEL=


# ── the FOMO reader ───────────────────────────────────────────────────────────
# How it gets inside a signed-in browser, because FOMO has no public API and
# its backend sits behind Cloudflare and a short-lived token.
#
#   browser-use   attaches to the Chrome already open on this machine. Local
#                 only: there is no open browser on a server.
#   playwright    brings its own headless Chromium. What Railway uses.
#
# Unset picks browser-use locally and playwright on a server.
FOMO_DRIVER=

# Where playwright keeps the session. MUST be on a volume in production, or
# every deploy signs out and the feed silently returns nothing.
FOMO_PROFILE_DIR=

# Where the reader asks which tokens to watch. Defaults to localhost:3000.
FOMO_TOKENS_URL=

# One sweep per this many seconds, and how far back each reaches. The lookback
# is far longer than the interval on purpose: overlapping windows cost nothing
# because the id dedupes them, while a gap after a restart loses a thesis for
# good, since the feed will not return it again.
FOMO_POLL_SECONDS=300
FOMO_LOOKBACK_SECONDS=86400

# Chromium only grows. The playwright driver relaunches on this timer.
FOMO_RECYCLE_HOURS=6

# How many callout authors to look up per sweep, and how far apart.
#
# This is the only way a FOMO contributor gets paid: FOMO holds a custodial
# wallet per account and returns it for any user id, so nobody has to paste an
# address into a market callout.
#
# Measured on 2026-09-12: the seventh request in a row returns 429 with
# retry-after 60, whether fired back to back or spaced 1.5s apart. The limit
# counts requests rather than measuring a rate, so raising the spacing does not
# help and only a smaller batch does. Four leaves room for the feed pages in the
# same sweep, which share the same Cloudflare budget.
FOMO_WALLET_BATCH=4
FOMO_WALLET_SPACING_MS=1000


# ── the chain ─────────────────────────────────────────────────────────────────
# Defaults to Arc's public RPC, which caps eth_getLogs and rate-limits.
RPC_URL=
# The paid endpoint carries its key in the URL PATH, which is why every error is
# redacted before it reaches a log or `hm_jobs.last_error`.
RPC_URL_PAID=
INDEXER_URL=

# Signs the payout list. Never put this in the web app: that process is
# internet-facing and this one has no public address.
KEEPER_PRIVATE_KEY=


# ── knobs ─────────────────────────────────────────────────────────────────────
# Seconds between polls when the queue is empty.
HM_POLL_SECONDS=30

# Which week the demo looks at. Defaults to the one that just closed, which is
# what the scheduler does. Set it to look further back: a project can be quiet
# for a month and then merge everything at once, and the most recent week is
# rarely the interesting one.
HM_DEMO_EPOCH=

# Most items one lane may contribute to one week. A week returning thousands
# means a coin pointed its rules at something far too broad. Lower it to keep a
# first paid run cheap: HM_LANE_CAP=5 scores five pull requests, not fifty-five.
HM_LANE_CAP=500

# The weekly pot, in base units, used by the demo only. OPEN DECISION: the real
# rule is the one percent cap measured against the vault balance, which needs
# the vault contract to exist.
#   1000 tokens at 18dp, 500 USDC at 6dp
HM_COIN_POT=1000000000000000000000
HM_USDC_POT=500000000

# Compresses the epoch clock so the state machine can be exercised in seconds
# rather than weeks. REFUSED on Arc and in production, because a shortened week
# would disagree with the vault and the revert would be the first anyone heard.
# HM_EPOCH_SECONDS_OVERRIDE=60
